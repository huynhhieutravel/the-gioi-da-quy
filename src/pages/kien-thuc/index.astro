---
import StoreLayout from '../../layouts/StoreLayout.astro';
import { getDb } from '../../lib/db';

export const prerender = false;

const db = getDb(Astro.locals);

const articles = (await db.prepare(`
  SELECT id, slug, title, category, thumbnail, excerpt, published_at
  FROM posts
  WHERE is_page = 0
  ORDER BY published_at DESC
`).all<any>()).results || [];
---

<StoreLayout title="Kiến Thức Đá Quý & Phong Thủy" activeNav="blog">
  <div class="container" style="padding: 40px 24px;">
    <div style="text-align: center; max-width: 700px; margin: 0 auto 40px;">
      <span style="font-size: 13px; font-weight: 700; text-transform: uppercase; color: var(--gold-accent); letter-spacing: 1.5px;">Cẩm Nang Phong Thủy</span>
      <h1 style="font-family: var(--font-heading); font-size: 34px; color: #fff; margin-top: 6px;">Kiến Thức Đá Quý & Linh Vật</h1>
      <p style="color: var(--text-muted); font-size: 15px; margin-top: 10px;">
        Tổng hợp kiến thức chuyên sâu về năng lượng đá tự nhiên, cách chọn Phật bản mệnh và đặt linh vật chiêu tài đón lộc.
      </p>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(340px, 1fr)); gap: 30px;">
      {articles.map((a) => (
        <div style="background: var(--store-card); border: 1px solid var(--store-border); border-radius: 14px; overflow: hidden; display: flex; flex-direction: column;">
          {a.thumbnail && (
            <img src={a.thumbnail} alt={a.title} style="width: 100%; height: 210px; object-fit: cover;" />
          )}
          <div style="padding: 24px; display: flex; flex-direction: column; flex: 1;">
            <span style="font-size: 12px; color: var(--gold-accent); font-weight: 600; margin-bottom: 8px;">
              {a.category} • {a.published_at}
            </span>
            <a href={`/kien-thuc/${a.slug}`} style="font-size: 18px; font-weight: 700; color: #fff; text-decoration: none; margin-bottom: 12px; line-height: 1.4;">
              {a.title}
            </a>
            <p style="font-size: 14px; color: var(--text-muted); line-height: 1.6; margin-bottom: 20px;">
              {a.excerpt}
            </p>
            <div style="margin-top: auto;">
              <a href={`/kien-thuc/${a.slug}`} class="btn-detail-link" style="display: inline-block;">
                Đọc bài viết chi tiết →
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</StoreLayout>
