---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getDb } from '../../../lib/db';

export const prerender = false;

const db = getDb(Astro.locals);
const url = new URL(Astro.request.url);

// Query parameters
const q = url.searchParams.get('q') || '';
const category = url.searchParams.get('cat') || '';
const element = url.searchParams.get('el') || '';
const tab = url.searchParams.get('tab') || 'all'; // all, in_stock, out_of_stock, featured
const sort = url.searchParams.get('sort') || 'id_asc';
const pageSize = parseInt(url.searchParams.get('page_size') || '15', 10);
const page = parseInt(url.searchParams.get('page') || '1', 10);
const offset = (page - 1) * pageSize;

// Count queries for status tabs
const countAll = (await db.prepare('SELECT COUNT(*) as count FROM products').first<{ count: number }>())?.count || 0;
const countInStock = (await db.prepare("SELECT COUNT(*) as count FROM products WHERE stock_status = 'in_stock'").first<{ count: number }>())?.count || 0;
const countOutOfStock = (await db.prepare("SELECT COUNT(*) as count FROM products WHERE stock_status = 'out_of_stock'").first<{ count: number }>())?.count || 0;
const countFeatured = (await db.prepare('SELECT COUNT(*) as count FROM products WHERE is_featured = 1').first<{ count: number }>())?.count || 0;

// Build dynamic WHERE clause
const whereConditions: string[] = [];
const params: any[] = [];

// Tab filter
if (tab === 'in_stock') {
  whereConditions.push("stock_status = 'in_stock'");
} else if (tab === 'out_of_stock') {
  whereConditions.push("stock_status = 'out_of_stock'");
} else if (tab === 'featured') {
  whereConditions.push('is_featured = 1');
}

// Search filter
if (q) {
  const rawTerm = `%${q}%`;
  const slugTerm = `%${q.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/đ/g, 'd').replace(/[^a-z0-9]+/g, '%')}%`;
  whereConditions.push('(name LIKE ? OR slug LIKE ? OR sku LIKE ? OR gemstone_type LIKE ?)');
  params.push(rawTerm, slugTerm, rawTerm, rawTerm);
}

// Category filter
if (category) {
  whereConditions.push('category_name = ?');
  params.push(category);
}

// Element filter
if (element) {
  whereConditions.push('feng_shui_element = ?');
  params.push(element);
}

const whereSql = whereConditions.length > 0 ? `WHERE ${whereConditions.join(' AND ')}` : '';

// Sort order
let orderSql = 'ORDER BY id ASC';
if (sort === 'price_desc') orderSql = 'ORDER BY price DESC';
if (sort === 'price_asc') orderSql = 'ORDER BY price ASC';
if (sort === 'name_asc') orderSql = 'ORDER BY name ASC';
if (sort === 'views_desc') orderSql = 'ORDER BY views DESC';
if (sort === 'featured') orderSql = 'ORDER BY is_featured DESC, id ASC';

// Total matching count
const countSql = `SELECT COUNT(*) as count FROM products ${whereSql}`;
const totalCount = (await db.prepare(countSql).bind(...params).first<{ count: number }>())?.count || 0;
const totalPages = Math.ceil(totalCount / pageSize) || 1;

// Paginated query
const productsSql = `
  SELECT id, slug, name, sku, price, price_text, original_price, category_name, gemstone_type,
         feng_shui_element, target_zodiac, thumbnail, stock_status, is_featured, views, short_description, dimensions, weight, certification
  FROM products
  ${whereSql}
  ${orderSql}
  LIMIT ? OFFSET ?
`;
const products = (await db.prepare(productsSql).bind(...params, pageSize, offset).all<any>()).results || [];

// Categories list
const categories = (await db.prepare('SELECT DISTINCT name FROM categories ORDER BY sort_order ASC').all<{ name: string }>()).results || [];
---

<AdminLayout title="Quản Lý Sản Phẩm" activeNav="products" breadcrumbs={[{ label: 'Sản Phẩm' }]}>
  <div class="page-header">
    <div class="page-title">
      <h2>Kho Đá Quý & Sản Phẩm Phong Thủy ({countAll})</h2>
      <p>Hệ thống quản lý vật phẩm phong thủy chuẩn WordPress & FIT Tour CMS</p>
    </div>
    <div class="page-actions">
      <a href="/admin/products/new" class="btn-primary">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width: 16px; height: 16px;">
          <line x1="12" y1="5" x2="12" y2="19"></line>
          <line x1="5" y1="12" x2="19" y2="12"></line>
        </svg>
        <span>+ Thêm Sản Phẩm Mới</span>
      </a>
    </div>
  </div>

  <!-- STATUS TABS (FIT Tour / WordPress Style) -->
  <div class="status-tabs">
    <a href={`/admin/products?tab=all&q=${encodeURIComponent(q)}&cat=${encodeURIComponent(category)}&el=${encodeURIComponent(element)}&sort=${encodeURIComponent(sort)}`} class={`status-tab ${tab === 'all' ? 'active' : ''}`}>
      <span>Tất cả</span>
      <span class="tab-badge">{countAll}</span>
    </a>
    <a href={`/admin/products?tab=in_stock&q=${encodeURIComponent(q)}&cat=${encodeURIComponent(category)}&el=${encodeURIComponent(element)}&sort=${encodeURIComponent(sort)}`} class={`status-tab ${tab === 'in_stock' ? 'active' : ''}`}>
      <span>Còn hàng</span>
      <span class="tab-badge">{countInStock}</span>
    </a>
    <a href={`/admin/products?tab=out_of_stock&q=${encodeURIComponent(q)}&cat=${encodeURIComponent(category)}&el=${encodeURIComponent(element)}&sort=${encodeURIComponent(sort)}`} class={`status-tab ${tab === 'out_of_stock' ? 'active' : ''}`}>
      <span>Tạm hết hàng</span>
      <span class="tab-badge">{countOutOfStock}</span>
    </a>
    <a href={`/admin/products?tab=featured&q=${encodeURIComponent(q)}&cat=${encodeURIComponent(category)}&el=${encodeURIComponent(element)}&sort=${encodeURIComponent(sort)}`} class={`status-tab ${tab === 'featured' ? 'active' : ''}`}>
      <span>⭐ Nổi bật</span>
      <span class="tab-badge">{countFeatured}</span>
    </a>
  </div>

  <!-- FILTER & SEARCH BAR -->
  <div class="admin-card" style="padding: 16px 20px; margin-bottom: 16px;">
    <form method="GET" action="/admin/products" style="display: flex; flex-wrap: wrap; gap: 12px; align-items: center;">
      <input type="hidden" name="tab" value={tab} />

      <!-- Search input -->
      <div style="flex: 2; min-width: 220px; position: relative;">
        <input 
          type="text" 
          name="q" 
          value={q} 
          placeholder="Tìm kiếm sản phẩm theo tên, SKU, chất đá..." 
          class="form-control"
          style="padding-left: 36px;"
        />
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="position: absolute; left: 12px; top: 50%; transform: translateY(-50%); width: 16px; height: 16px; color: var(--text-dim);">
          <circle cx="11" cy="11" r="8"></circle>
          <path d="m21 21-4.3-4.3"></path>
        </svg>
      </div>

      <!-- Category Filter -->
      <div style="flex: 1; min-width: 150px;">
        <select name="cat" class="form-control" onchange="this.form.submit()">
          <option value="">-- Tất cả chủng loại --</option>
          {categories.map((c) => (
            <option value={c.name} selected={category === c.name}>{c.name}</option>
          ))}
        </select>
      </div>

      <!-- Element Filter -->
      <div style="flex: 1; min-width: 130px;">
        <select name="el" class="form-control" onchange="this.form.submit()">
          <option value="">-- Ngũ Hành --</option>
          <option value="Kim" selected={element === 'Kim'}>Mệnh Kim</option>
          <option value="Mộc" selected={element === 'Mộc'}>Mệnh Mộc</option>
          <option value="Thủy" selected={element === 'Thủy'}>Mệnh Thủy</option>
          <option value="Hỏa" selected={element === 'Hỏa'}>Mệnh Hỏa</option>
          <option value="Thổ" selected={element === 'Thổ'}>Mệnh Thổ</option>
          <option value="Đa Mệnh" selected={element === 'Đa Mệnh'}>Đa Mệnh</option>
        </select>
      </div>

      <!-- Sort Filter -->
      <div style="flex: 1; min-width: 140px;">
        <select name="sort" class="form-control" onchange="this.form.submit()">
          <option value="id_asc" selected={sort === 'id_asc'}>Mặc định (ID)</option>
          <option value="price_desc" selected={sort === 'price_desc'}>Giá cao → thấp</option>
          <option value="price_asc" selected={sort === 'price_asc'}>Giá thấp → cao</option>
          <option value="name_asc" selected={sort === 'name_asc'}>Tên A → Z</option>
          <option value="views_desc" selected={sort === 'views_desc'}>Lượt xem nhiều</option>
          <option value="featured" selected={sort === 'featured'}>Nổi bật trước</option>
        </select>
      </div>

      <!-- Page Size Filter -->
      <div style="width: 110px;">
        <select name="page_size" class="form-control" onchange="this.form.submit()">
          <option value="15" selected={pageSize === 15}>15 dòng</option>
          <option value="30" selected={pageSize === 30}>30 dòng</option>
          <option value="50" selected={pageSize === 50}>50 dòng</option>
        </select>
      </div>

      <!-- Submit & Reset -->
      <button type="submit" class="btn-primary" style="padding: 10px 16px;">
        <span>Lọc</span>
      </button>

      {(q || category || element || sort !== 'id_asc' || tab !== 'all') && (
        <a href="/admin/products" class="btn-secondary" style="padding: 10px 14px;">
          <span>Đặt lại</span>
        </a>
      )}
    </form>
  </div>

  <!-- BULK ACTIONS TOOLBAR -->
  <div class="bulk-toolbar" id="bulk-toolbar">
    <div style="display: flex; align-items: center; gap: 8px;">
      <input type="checkbox" id="select-all" style="width: 17px; height: 17px; cursor: pointer;" onchange="toggleSelectAll(this)" />
      <label for="select-all" style="font-size: 13px; font-weight: 600; color: #334155; cursor: pointer; margin: 0;">
        Chọn tất cả
      </label>
    </div>

    <div style="display: flex; align-items: center; gap: 8px; margin-left: 12px;">
      <select id="bulk-action-select" class="form-control" style="width: 220px; padding: 6px 12px; font-size: 13px;">
        <option value="">-- Hành động hàng loạt --</option>
        <option value="set_stock_in">Đổi thành: Còn hàng</option>
        <option value="set_stock_out">Đổi thành: Tạm hết hàng</option>
        <option value="set_featured_on">⭐ Đặt làm Nổi bật</option>
        <option value="set_featured_off">Bỏ đánh dấu Nổi bật</option>
        <option value="delete_bulk">🗑️ Xóa các mục đã chọn</option>
      </select>

      <button type="button" class="btn-secondary" style="padding: 7px 14px; font-size: 13px;" onclick="applyBulkAction()">
        Áp dụng
      </button>
    </div>

    <div id="bulk-selected-info" class="bulk-count-tag" style="display: none; margin-left: auto;">
      <span>Đã chọn: <strong id="selected-count">0</strong> sản phẩm</span>
    </div>
  </div>

  <!-- PRODUCTS TABLE -->
  <div class="admin-card" style="padding: 0; overflow: hidden;">
    <div class="table-responsive">
      <table class="admin-table">
        <thead>
          <tr>
            <th style="width: 40px; text-align: center;"></th>
            <th style="width: 40px; text-align: center;">⭐</th>
            <th style="min-width: 260px;">Tên Sản Phẩm & SKU</th>
            <th>Chủng Loại</th>
            <th>Ngũ Hành</th>
            <th>Bản Mệnh / Tuổi</th>
            <th>Giá Bán</th>
            <th style="text-align: center;">Tình Trạng Kho</th>
            <th style="text-align: right; width: 140px;">Thao Tác</th>
          </tr>
        </thead>
        <tbody>
          {products.length === 0 ? (
            <tr>
              <td colspan="9" style="text-align: center; padding: 48px; color: var(--text-dim);">
                Không tìm thấy sản phẩm nào khớp với điều kiện tìm kiếm.
              </td>
            </tr>
          ) : (
            products.map((p, index) => {
              const badgeClass = p.feng_shui_element === 'Kim' ? 'badge-kim'
                : p.feng_shui_element === 'Mộc' ? 'badge-moc'
                : p.feng_shui_element === 'Thủy' ? 'badge-thuy'
                : p.feng_shui_element === 'Hỏa' ? 'badge-hoa'
                : p.feng_shui_element === 'Thổ' ? 'badge-tho' : 'badge-damenh';

              return (
                <tr id={`row-${p.id}`}>
                  <!-- Row Checkbox -->
                  <td style="text-align: center;">
                    <input 
                      type="checkbox" 
                      class="row-checkbox" 
                      value={p.id} 
                      style="width: 16px; height: 16px; cursor: pointer;" 
                      onchange="updateSelectionCount()"
                    />
                  </td>

                  <!-- Fast Star Toggle -->
                  <td style="text-align: center;">
                    <button 
                      type="button" 
                      class={`star-toggle ${p.is_featured === 1 ? 'active' : ''}`} 
                      id={`star-${p.id}`}
                      title={p.is_featured === 1 ? 'Sản phẩm nổi bật (Bấm để hủy)' : 'Bấm để đánh dấu nổi bật'}
                      onclick={`toggleFeatured('${p.id}')`}
                    >
                      ★
                    </button>
                  </td>

                  <!-- Product Name, SKU & Hover Actions -->
                  <td>
                    <div class="cell-product">
                      <img src={p.thumbnail || '/placeholder-gem.jpg'} alt={p.name} class="product-thumb-sm" loading="lazy" />
                      <div class="product-meta-cell">
                        <a href={`/admin/products/edit?id=${p.id}`} class="product-title-link">
                          {p.name}
                        </a>
                        <span class="product-sku-text">SKU: {p.sku}</span>

                        <!-- FIT Tour / WordPress style hover action links -->
                        <div class="row-quick-actions">
                          <a href={`/admin/products/edit?id=${p.id}`} class="row-action-link">Chỉnh sửa</a>
                          <span class="row-action-sep">•</span>
                          <button type="button" class="row-action-link" onclick={`openQuickView('${p.id}')`}>Xem nhanh</button>
                          <span class="row-action-sep">•</span>
                          <a href={`/san-pham/${p.slug}`} target="_blank" class="row-action-link">Xem trên web ↗</a>
                          <span class="row-action-sep">•</span>
                          <button type="button" class="row-action-link" onclick={`duplicateProduct('${p.id}', '${p.name.replace(/'/g, "\\'")}')`}>Nhân bản</button>
                          <span class="row-action-sep">•</span>
                          <button type="button" class="row-action-link danger" onclick={`deleteProduct('${p.id}', '${p.name.replace(/'/g, "\\'")}')`}>Xóa</button>
                        </div>
                      </div>
                    </div>
                  </td>

                  <!-- Gemstone Type -->
                  <td>
                    <span style="font-weight: 500; color: #334155; font-size: 13px;">{p.gemstone_type || p.category_name}</span>
                  </td>

                  <!-- Feng Shui Element -->
                  <td>
                    <span class={`badge ${badgeClass}`}>{p.feng_shui_element}</span>
                  </td>

                  <!-- Zodiac / Age -->
                  <td>
                    <span style="font-size: 12px; color: var(--text-muted);">{p.target_zodiac}</span>
                  </td>

                  <!-- Price -->
                  <td>
                    <span class="price-text-highlight">{p.price_text}</span>
                  </td>

                  <!-- Stock Status Toggle -->
                  <td style="text-align: center;">
                    <span 
                      id={`stock-badge-${p.id}`}
                      class={`badge badge-interactive ${p.stock_status === 'in_stock' ? 'badge-stock-in' : 'badge-stock-out'}`}
                      title="Bấm để chuyển nhanh trạng thái kho"
                      onclick={`toggleStockStatus('${p.id}', '${p.stock_status}')`}
                    >
                      {p.stock_status === 'in_stock' ? 'Còn hàng' : 'Hết hàng'}
                    </span>
                  </td>

                  <!-- Fast Action Buttons -->
                  <td style="text-align: right;">
                    <div class="action-buttons" style="justify-content: flex-end;">
                      <button type="button" class="btn-icon" title="Xem nhanh thông tin" onclick={`openQuickView('${p.id}')`}>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width: 14px; height: 14px;">
                          <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"></path>
                          <circle cx="12" cy="12" r="3"></circle>
                        </svg>
                      </button>
                      <a href={`/admin/products/edit?id=${p.id}`} class="btn-icon" title="Chỉnh sửa chi tiết">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width: 14px; height: 14px;">
                          <path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"></path>
                        </svg>
                      </a>
                      <a href={`/san-pham/${p.slug}`} target="_blank" class="btn-icon" title="Xem trên website showroom">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width: 14px; height: 14px;">
                          <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                          <polyline points="15 3 21 3 21 9"></polyline>
                          <line x1="10" x2="21" y1="14" y2="3"></line>
                        </svg>
                      </a>
                    </div>
                  </td>
                </tr>
              );
            })
          )}
        </tbody>
      </table>
    </div>

    <!-- PAGINATION -->
    <div style="display: flex; justify-content: space-between; align-items: center; padding: 16px 24px; border-top: 1px solid var(--border-subtle); flex-wrap: wrap; gap: 12px;">
      <span style="font-size: 13px; color: var(--text-muted);">
        Hiển thị <strong>{products.length}</strong> trên tổng số <strong>{totalCount}</strong> sản phẩm (Trang {page} / {totalPages})
      </span>
      {totalPages > 1 && (
        <div style="display: flex; gap: 6px; align-items: center;">
          {page > 1 && (
            <a href={`/admin/products?page=${page - 1}&tab=${tab}&q=${encodeURIComponent(q)}&cat=${encodeURIComponent(category)}&el=${encodeURIComponent(element)}&sort=${encodeURIComponent(sort)}&page_size=${pageSize}`} class="btn-secondary" style="padding: 6px 12px; font-size: 12px;">
              ← Trước
            </a>
          )}

          {Array.from({ length: totalPages }, (_, i) => i + 1).map((pNum) => {
            if (pNum === 1 || pNum === totalPages || (pNum >= page - 2 && pNum <= page + 2)) {
              return (
                <a 
                  href={`/admin/products?page=${pNum}&tab=${tab}&q=${encodeURIComponent(q)}&cat=${encodeURIComponent(category)}&el=${encodeURIComponent(element)}&sort=${encodeURIComponent(sort)}&page_size=${pageSize}`} 
                  class={pNum === page ? 'btn-primary' : 'btn-secondary'}
                  style="padding: 6px 12px; font-size: 12px; min-width: 32px; text-align: center;"
                >
                  {pNum}
                </a>
              );
            }
            return null;
          })}

          {page < totalPages && (
            <a href={`/admin/products?page=${page + 1}&tab=${tab}&q=${encodeURIComponent(q)}&cat=${encodeURIComponent(category)}&el=${encodeURIComponent(element)}&sort=${encodeURIComponent(sort)}&page_size=${pageSize}`} class="btn-primary" style="padding: 6px 12px; font-size: 12px;">
              Sau →
            </a>
          )}
        </div>
      )}
    </div>
  </div>

  <!-- QUICK VIEW MODAL (WordPress / FIT Tour Style) -->
  <dialog id="quick-view-modal" class="quick-view-dialog" style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 14px; box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1); padding: 0; max-width: 680px;">
    <div class="quick-view-header" style="background: #ffffff; border-bottom: 1px solid #e2e8f0; padding: 18px 24px; display: flex; justify-content: space-between; align-items: center;">
      <div style="display: flex; align-items: center; gap: 10px;">
        <span style="font-size: 20px;">💎</span>
        <div>
          <h3 id="qv-title" style="font-size: 16px; margin: 0; color: #0f172a; font-weight: 700;">Xem Nhanh Sản Phẩm</h3>
          <span id="qv-sku" style="font-size: 12px; color: #2563eb; font-family: monospace; font-weight: 600;">SKU: ...</span>
        </div>
      </div>
      <button type="button" class="btn-icon" style="width: 28px; height: 28px;" onclick="document.getElementById('quick-view-modal').close()">✕</button>
    </div>

    <div class="quick-view-body" id="qv-body" style="padding: 24px;">
      <div style="display: grid; grid-template-columns: 200px 1fr; gap: 20px;">
        <div>
          <img id="qv-img" src="" alt="" style="width: 100%; aspect-ratio: 1; object-fit: cover; border-radius: 10px; border: 1px solid #e2e8f0;" />
          <div style="margin-top: 12px; text-align: center;">
            <div id="qv-price" style="font-size: 18px; font-weight: 700; color: #d97706;"></div>
            <div id="qv-stock" style="margin-top: 6px;"></div>
          </div>
        </div>

        <div>
          <table style="width: 100%; font-size: 13px; line-height: 1.8;">
            <tr>
              <td style="color: #64748b; width: 120px; font-weight: 500;">Chủng loại:</td>
              <td id="qv-cat" style="font-weight: 600; color: #0f172a;"></td>
            </tr>
            <tr>
              <td style="color: #64748b; font-weight: 500;">Chất liệu đá:</td>
              <td id="qv-gem" style="color: #334155; font-weight: 500;"></td>
            </tr>
            <tr>
              <td style="color: #64748b; font-weight: 500;">Ngũ hành:</td>
              <td id="qv-element"></td>
            </tr>
            <tr>
              <td style="color: #64748b; font-weight: 500;">Bản mệnh / Tuổi:</td>
              <td id="qv-zodiac" style="color: #334155; font-weight: 500;"></td>
            </tr>
            <tr>
              <td style="color: #64748b; font-weight: 500;">Kích thước:</td>
              <td id="qv-dim" style="color: #334155; font-weight: 500;"></td>
            </tr>
            <tr>
              <td style="color: #64748b; font-weight: 500;">Trọng lượng:</td>
              <td id="qv-weight" style="color: #334155; font-weight: 500;"></td>
            </tr>
            <tr>
              <td style="color: #64748b; font-weight: 500;">Giám định:</td>
              <td id="qv-cert" style="color: #334155; font-weight: 500;"></td>
            </tr>
          </table>

          <div style="margin-top: 14px; padding-top: 12px; border-top: 1px solid #e2e8f0;">
            <div style="font-size: 11px; color: #64748b; font-weight: 700; text-transform: uppercase;">Mô tả ngắn:</div>
            <p id="qv-desc" style="font-size: 13px; color: #475569; margin-top: 4px; line-height: 1.5;"></p>
          </div>
        </div>
      </div>
    </div>

    <div class="quick-view-footer">
      <a id="qv-web-link" href="#" target="_blank" class="btn-secondary">Xem Trên Website ↗</a>
      <a id="qv-edit-link" href="#" class="btn-primary">Chỉnh Sửa Chi Tiết</a>
    </div>
  </dialog>

  <!-- JAVASCRIPT LOGIC (Interactive Features) -->
  <script is:inline>
    // 1. Toggle Selection & Bulk Count
    function toggleSelectAll(masterCheckbox) {
      const checkboxes = document.querySelectorAll('.row-checkbox');
      checkboxes.forEach(cb => cb.checked = masterCheckbox.checked);
      updateSelectionCount();
    }

    function updateSelectionCount() {
      const selected = document.querySelectorAll('.row-checkbox:checked');
      const count = selected.length;
      const infoBox = document.getElementById('bulk-selected-info');
      const countEl = document.getElementById('selected-count');

      if (count > 0) {
        infoBox.style.display = 'inline-flex';
        countEl.innerText = count;
      } else {
        infoBox.style.display = 'none';
        document.getElementById('select-all').checked = false;
      }
    }

    function getSelectedIds() {
      const checkboxes = document.querySelectorAll('.row-checkbox:checked');
      return Array.from(checkboxes).map(cb => cb.value);
    }

    // 2. Fast Star Toggle (Optimistic Update)
    async function toggleFeatured(id) {
      const btn = document.getElementById(`star-${id}`);
      const isCurrentlyFeatured = btn.classList.contains('active');
      const newFeatured = !isCurrentlyFeatured;

      // Optimistic UI update
      if (newFeatured) {
        btn.classList.add('active');
      } else {
        btn.classList.remove('active');
      }

      try {
        const res = await fetch('/api/admin/products', {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id, is_featured: newFeatured ? 1 : 0 })
        });
        const data = await res.json();
        if (data.success) {
          window.showToast(newFeatured ? 'Đã đánh dấu sản phẩm Nổi bật ⭐' : 'Đã bỏ đánh dấu Nổi bật', 'success');
        } else {
          // Revert on error
          btn.classList.toggle('active', isCurrentlyFeatured);
          alert('Lỗi: ' + (data.error?.message || 'Không thể cập nhật'));
        }
      } catch (err) {
        btn.classList.toggle('active', isCurrentlyFeatured);
        alert('Lỗi kết nối: ' + err.message);
      }
    }

    // 3. Fast Stock Status Toggle
    async function toggleStockStatus(id, currentStatus) {
      const badge = document.getElementById(`stock-badge-${id}`);
      const newStatus = currentStatus === 'in_stock' ? 'out_of_stock' : 'in_stock';

      try {
        const res = await fetch('/api/admin/products', {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id, stock_status: newStatus })
        });
        const data = await res.json();
        if (data.success) {
          if (newStatus === 'in_stock') {
            badge.className = 'badge badge-interactive badge-stock-in';
            badge.innerText = 'Còn hàng';
          } else {
            badge.className = 'badge badge-interactive badge-stock-out';
            badge.innerText = 'Hết hàng';
          }
          badge.setAttribute('onclick', `toggleStockStatus('${id}', '${newStatus}')`);
          window.showToast('Đã đổi tình trạng kho hàng!', 'success');
        } else {
          alert('Lỗi: ' + (data.error?.message || 'Không thể đổi tình trạng kho'));
        }
      } catch (err) {
        alert('Lỗi kết nối: ' + err.message);
      }
    }

    // 4. Duplicate Product
    async function duplicateProduct(id, name) {
      if (!confirm(`Bạn có muốn nhân bản sản phẩm "${name}" thành một bản sao mới không?`)) return;

      try {
        const res = await fetch('/api/admin/products', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'duplicate', id })
        });
        const data = await res.json();
        if (data.success) {
          window.showToast(`Đã nhân bản "${name}" thành công!`, 'success');
          setTimeout(() => window.location.reload(), 600);
        } else {
          alert('Lỗi: ' + (data.error?.message || 'Không thể nhân bản'));
        }
      } catch (err) {
        alert('Lỗi kết nối: ' + err.message);
      }
    }

    // 5. Delete Single Product
    async function deleteProduct(id, name) {
      if (!confirm(`Bạn có chắc chắn muốn xóa vĩnh viễn sản phẩm "${name}" không?`)) return;

      try {
        const res = await fetch(`/api/admin/products?id=${encodeURIComponent(id)}`, {
          method: 'DELETE'
        });
        const data = await res.json();
        if (data.success) {
          const row = document.getElementById(`row-${id}`);
          if (row) row.remove();
          window.showToast(`Đã xóa thành công: ${name}`, 'success');
          updateSelectionCount();
        } else {
          alert('Lỗi: ' + (data.error?.message || 'Không thể xóa'));
        }
      } catch (e) {
        alert('Lỗi kết nối: ' + e.message);
      }
    }

    // 6. Apply Bulk Action
    async function applyBulkAction() {
      const action = document.getElementById('bulk-action-select').value;
      const ids = getSelectedIds();

      if (!action) {
        alert('Vui lòng chọn một hành động cần thực hiện');
        return;
      }

      if (ids.length === 0) {
        alert('Vui lòng tích chọn ít nhất 1 sản phẩm');
        return;
      }

      let payload = { action, ids };

      if (action === 'set_stock_in') {
        payload.action = 'set_stock';
        payload.value = 'in_stock';
      } else if (action === 'set_stock_out') {
        payload.action = 'set_stock';
        payload.value = 'out_of_stock';
      } else if (action === 'set_featured_on') {
        payload.action = 'set_featured';
        payload.value = 1;
      } else if (action === 'set_featured_off') {
        payload.action = 'set_featured';
        payload.value = 0;
      } else if (action === 'delete_bulk') {
        if (!confirm(`CẢNH BÁO: Bạn có chắc chắn muốn XÓA VĨNH VIỄN ${ids.length} sản phẩm đã chọn?`)) {
          return;
        }
      }

      try {
        const res = await fetch('/api/admin/products', {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        const data = await res.json();
        if (data.success) {
          window.showToast(`Thao tác thành công trên ${ids.length} sản phẩm!`, 'success');
          setTimeout(() => window.location.reload(), 600);
        } else {
          alert('Lỗi: ' + (data.error?.message || 'Thao tác hàng loạt thất bại'));
        }
      } catch (err) {
        alert('Lỗi kết nối: ' + err.message);
      }
    }

    // 7. Quick View Modal Loader
    async function openQuickView(id) {
      const modal = document.getElementById('quick-view-modal');
      modal.showModal();

      document.getElementById('qv-title').innerText = 'Đang tải dữ liệu...';
      document.getElementById('qv-sku').innerText = '';
      document.getElementById('qv-img').src = '/placeholder-gem.jpg';

      try {
        const res = await fetch(`/api/admin/products?id=${encodeURIComponent(id)}`);
        const result = await res.json();
        if (result.success && result.data) {
          const p = result.data;
          document.getElementById('qv-title').innerText = p.name;
          document.getElementById('qv-sku').innerText = `Mã SKU: ${p.sku}`;
          document.getElementById('qv-img').src = p.thumbnail || '/placeholder-gem.jpg';
          document.getElementById('qv-price').innerText = p.price_text;
          document.getElementById('qv-cat').innerText = p.category_name || 'N/A';
          document.getElementById('qv-gem').innerText = p.gemstone_type || 'Đá tự nhiên';
          document.getElementById('qv-element').innerHTML = `<span class="badge badge-tho">${p.feng_shui_element}</span>`;
          document.getElementById('qv-zodiac').innerText = p.target_zodiac || 'Mọi độ tuổi';
          document.getElementById('qv-dim').innerText = p.dimensions || 'Tiêu chuẩn showroom';
          document.getElementById('qv-weight').innerText = p.weight || 'Theo sản phẩm';
          document.getElementById('qv-cert').innerText = p.certification || 'Giám định đá tự nhiên';
          document.getElementById('qv-desc').innerText = p.short_description || 'Chưa có mô tả ngắn.';

          const stockEl = document.getElementById('qv-stock');
          if (p.stock_status === 'in_stock') {
            stockEl.innerHTML = '<span class="badge badge-stock-in">Còn hàng (Sẵn sàng giao)</span>';
          } else {
            stockEl.innerHTML = '<span class="badge badge-stock-out">Tạm hết hàng</span>';
          }

          document.getElementById('qv-web-link').href = `/san-pham/${p.slug}`;
          document.getElementById('qv-edit-link').href = `/admin/products/edit?id=${p.id}`;
        }
      } catch (err) {
        alert('Lỗi tải thông tin xem nhanh: ' + err.message);
      }
    }
  </script>
</AdminLayout>
