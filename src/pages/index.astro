---
import StoreLayout from '../layouts/StoreLayout.astro';
import { getDb } from '../lib/db';

export const prerender = false;

const db = getDb(Astro.locals);

// 1. Featured Products
const featuredProducts = (await db.prepare(`
  SELECT id, slug, name, sku, price_text, category_name, gemstone_type, feng_shui_element, thumbnail
  FROM products
  WHERE is_featured = 1
  LIMIT 12
`).all<any>()).results || [];

// Total Product Count
const totalProducts = (await db.prepare('SELECT COUNT(*) as count FROM products').first<{ count: number }>())?.count || 380;

// 2. All Categories
const categories = (await db.prepare(`
  SELECT c.name, c.slug, c.element, c.description, COUNT(p.id) as count
  FROM categories c
  LEFT JOIN products p ON p.category_name = c.name
  GROUP BY c.id
  ORDER BY c.sort_order ASC
`).all<any>()).results || [];

// 3. Latest News & Knowledge Articles
const articles = (await db.prepare(`
  SELECT id, slug, title, category, thumbnail, excerpt, published_at
  FROM posts
  WHERE is_page = 0
  ORDER BY published_at DESC
  LIMIT 6
`).all<any>()).results || [];

const settingsRows = (await db.prepare('SELECT key, value FROM settings').all<{ key: string; value: string }>()).results || [];
const s: Record<string, string> = {};
for (const r of settingsRows) s[r.key] = r.value;

const websiteSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": "https://thegioidaquy.net/#website",
      "url": "https://thegioidaquy.net",
      "name": "Thế Giới Đá Quý - Phong Thủy Hoa Mộc Lan",
      "alternateName": ["Phong Thủy Hoa Mộc Lan", "The Gioi Da Quy"],
      "description": "Cửa hàng đá quý phong thủy thiên nhiên Hoa Mộc Lan TP.HCM - Hơn 15 năm uy tín cung cấp đá quý phong thủy, Phật bản mệnh 12 con giáp, linh vật chiêu tài kiểm định SJC, PNJ.",
      "publisher": {
        "@id": "https://thegioidaquy.net/#organization"
      },
      "potentialAction": {
        "@type": "SearchAction",
        "target": {
          "@type": "EntryPoint",
          "urlTemplate": "https://thegioidaquy.net/san-pham?q={search_term_string}"
        },
        "query-input": "required name=search_term_string"
      },
      "inLanguage": "vi-VN"
    }
  ]
};
---

<StoreLayout title="Trang Chủ" activeNav="home" schemaJson={websiteSchema}>
  <!-- HERO BANNER -->
  <section class="hero-section">
    <div class="container hero-content">
      <span class="hero-subtitle">✨ Tuyệt Tác Đá Quý Phong Thủy Cao Cấp</span>
      <h1 class="hero-title">
        Khơi Nguồn Vượng Khí,<br />
        <span>Tài Lộc & Bình An Trọn Đời</span>
      </h1>
      <p class="hero-desc">
        Hơn 15 năm uy tín cung cấp đá quý tự nhiên 100%, Phật bản mệnh 12 con giáp, linh vật chiêu tài Tỳ Hưu, Thiềm Thừ. 
        Đầy đủ giấy chứng thư giám định đá quý tại các trung tâm SJC, PNJ, RGG toàn quốc.
      </p>

      <div class="hero-badges">
        <a href="/gioi-thieu" class="hero-badge-item">💎 100% Đá Tự Nhiên</a>
        <a href="/chinh-sach-va-quy-dinh" class="hero-badge-item">📜 Giám Định SJC, PNJ</a>
        <a href="/giao-nhan" class="hero-badge-item">🚚 Giao Hàng Toàn Quốc COD</a>
        <a href="/chinh-sach-va-quy-dinh" class="hero-badge-item">🛡️ Bảo Hành Dây Trọn Đời</a>
      </div>

      <!-- Quick Search Bar in Hero -->
      <div class="hero-search-container">
        <form action="/san-pham" method="GET" class="hero-search-box" role="search">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width: 18px; height: 18px;">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <input 
            type="search" 
            name="q" 
            placeholder="Tìm kiếm theo tên đá, linh vật (Thạch anh, Tỳ Hưu, Ngọc Bích...)" 
            autocomplete="off"
            aria-label="Tìm kiếm sản phẩm phong thủy"
          />
          <button type="submit">Tìm Kiếm</button>
        </form>
        <div class="hero-search-tags">
          <span>Gợi ý:</span>
          <a href="/san-pham?q=Thạch+Anh" class="hero-search-tag-link">Thạch Anh</a>
          <a href="/san-pham?q=Mắt+Hổ" class="hero-search-tag-link">Mắt Hổ</a>
          <a href="/san-pham?q=Ngọc+Bích" class="hero-search-tag-link">Ngọc Bích</a>
          <a href="/san-pham?q=Phật+Bản+Mệnh" class="hero-search-tag-link">Phật Bản Mệnh</a>
          <a href="/san-pham?q=Tỳ+Hưu" class="hero-search-tag-link">Tỳ Hưu</a>
          <a href="/san-pham?q=Ruby" class="hero-search-tag-link">Ruby</a>
        </div>
      </div>

      <div style="display: flex; justify-content: center; gap: 16px; margin-top: 24px;">
        <a href="/san-pham" class="btn-gold" style="padding: 12px 28px; font-size: 15px;">
          Xem Toàn Bộ {totalProducts} Vật Phẩm
        </a>
        <a href="#ngu-hanh" class="btn-secondary" style="padding: 12px 24px; font-size: 15px;">
          Tra Cứu Đá Theo Mệnh
        </a>
      </div>
    </div>
  </section>

  <!-- FENG SHUI ELEMENT FINDER -->
  <section class="container" id="ngu-hanh" style="padding: 20px 0;">
    <div class="element-finder-box">
      <h3>Chọn Đá Phong Thủy Theo Bản Mệnh Ngũ Hành</h3>
      <p>Ứng dụng quy luật Ngũ hành tương sinh tương hợp mang lại năng lượng may mắn, bình an và tài vượng đỉnh cao.</p>

      <div class="element-pills">
        <a href="/san-pham?el=Kim" class="element-pill kim">
          <span>⚪ Mệnh Kim</span>
          <small>(Thạch Anh Trắng, Ưu Linh)</small>
        </a>
        <a href="/san-pham?el=Mộc" class="element-pill moc">
          <span>🟢 Mệnh Mộc</span>
          <small>(Ngọc Bích, Cẩm Thạch, Serpentine)</small>
        </a>
        <a href="/san-pham?el=Thủy" class="element-pill thuy">
          <span>🔵 Mệnh Thủy</span>
          <small>(Hắc Ngà Obsidian, Lapis Lazuli)</small>
        </a>
        <a href="/san-pham?el=Hỏa" class="element-pill hoa">
          <span>🔴 Mệnh Hỏa</span>
          <small>(Ruby Đỏ, Thạch Anh Tím, Garnet)</small>
        </a>
        <a href="/san-pham?el=Thổ" class="element-pill tho">
          <span>🟡 Mệnh Thổ</span>
          <small>(Đá Mắt Hổ, Thạch Anh Vàng)</small>
        </a>
      </div>
    </div>
  </section>

  <!-- FEATURED PRODUCTS -->
  <section class="container" style="padding: 40px 0;">
    <div style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 24px;">
      <div>
        <span style="font-size: 12px; font-weight: 700; text-transform: uppercase; color: var(--gold-accent); letter-spacing: 1px;">Tuyển Chọn Đặc Biệt</span>
        <h3 style="font-family: var(--font-heading); font-size: 28px; color: #fff; margin-top: 4px;">Sản Phẩm Phong Thủy Nổi Bật</h3>
      </div>
      <a href="/san-pham" style="color: var(--gold-accent); font-weight: 600; font-size: 14px; text-decoration: none;">Xem tất cả {totalProducts} sản phẩm →</a>
    </div>

    <div class="products-grid">
      {featuredProducts.map((p) => {
        const badgeClass = p.feng_shui_element === 'Kim' ? 'badge-kim'
          : p.feng_shui_element === 'Mộc' ? 'badge-moc'
          : p.feng_shui_element === 'Thủy' ? 'badge-thuy'
          : p.feng_shui_element === 'Hỏa' ? 'badge-hoa'
          : p.feng_shui_element === 'Thổ' ? 'badge-tho' : 'badge-damenh';

        return (
          <div class="product-card">
            <div class="product-card-thumb">
              <img src={p.thumbnail || '/placeholder-gem.jpg'} alt={p.name} loading="lazy" />
              <span class={`product-element-tag ${badgeClass}`}>Mệnh {p.feng_shui_element}</span>
            </div>
            <div class="product-card-body">
              <span class="product-cat-label">{p.gemstone_type}</span>
              <a href={`/san-pham/${p.slug}`} class="product-card-title">{p.name}</a>
              <div class="product-price-box">
                <span class="price-current">{p.price_text}</span>
                <a href={`/san-pham/${p.slug}`} class="btn-detail-link">Chi tiết</a>
              </div>
            </div>
          </div>
        );
      })}
    </div>
  </section>

  <!-- GEMSTONE CATEGORIES STRIP -->
  <section class="container" style="padding: 30px 0;">
    <div style="text-align: center; margin-bottom: 30px;">
      <span style="font-size: 12px; font-weight: 700; text-transform: uppercase; color: var(--gold-accent); letter-spacing: 1px;">Dòng Đá Quý Tự Nhiên</span>
      <h3 style="font-family: var(--font-heading); font-size: 28px; color: #fff; margin-top: 4px;">15 Chủng Loại Đá Quý Phong Thủy</h3>
    </div>

    <div class="category-strip">
      {categories.map((c) => (
        <a href={`/san-pham?cat=${encodeURIComponent(c.name)}`} class="category-card">
          <h4>{c.name}</h4>
          <span>{c.count} sản phẩm</span>
        </a>
      ))}
    </div>
  </section>

  <!-- NEWS & KNOWLEDGE ARTICLES PREVIEW -->
  <section class="container" style="padding: 40px 0;">
    <div style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 24px; flex-wrap: wrap; gap: 12px;">
      <div>
        <span style="font-size: 12px; font-weight: 700; text-transform: uppercase; color: var(--gold-accent); letter-spacing: 1px;">Tin Tức & Cẩm Nang</span>
        <h3 style="font-family: var(--font-heading); font-size: 28px; color: #fff; margin-top: 4px;">Tin Tức & Cẩm Nang Phong Thủy Đời Sống</h3>
      </div>
      <a href="/tin-tuc" style="color: var(--gold-accent); font-weight: 600; font-size: 14px; text-decoration: none;">Xem tất cả bài viết tin tức →</a>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 24px;">
      {articles.map((a) => (
        <div style="background: var(--store-card); border: 1px solid var(--store-border); border-radius: 12px; overflow: hidden; display: flex; flex-direction: column;">
          {a.thumbnail && (
            <a href={`/tin-tuc/${a.slug}`} style="height: 180px; overflow: hidden; display: block;">
              <img src={a.thumbnail} alt={a.title} loading="lazy" style="width: 100%; height: 100%; object-fit: cover; transition: transform 0.3s;" onmouseover="this.style.transform='scale(1.05)'" onmouseout="this.style.transform='scale(1)'" />
            </a>
          )}
          <div style="padding: 20px; display: flex; flex-direction: column; flex: 1;">
            <span style="font-size: 12px; color: var(--gold-accent); margin-bottom: 8px;">{a.category} • {a.published_at}</span>
            <a href={`/tin-tuc/${a.slug}`} style="color: #fff; font-size: 16px; font-weight: 600; text-decoration: none; margin-bottom: 10px; line-height: 1.4;">
              {a.title}
            </a>
            <p style="font-size: 13px; color: var(--text-muted); line-height: 1.6; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;">
              {a.excerpt}
            </p>
            <div style="margin-top: auto; padding-top: 14px;">
              <a href={`/tin-tuc/${a.slug}`} style="font-size: 13px; color: var(--emerald-light); font-weight: 600; text-decoration: none;">
                Đọc bài viết →
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>
</StoreLayout>
