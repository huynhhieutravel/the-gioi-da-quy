---
import StoreLayout from '../../layouts/StoreLayout.astro';
import { getDb } from '../../lib/db';

export const prerender = false;

const db = getDb(Astro.locals);
const url = new URL(Astro.request.url);

const q = url.searchParams.get('q') || '';
const category = url.searchParams.get('cat') || '';
const element = url.searchParams.get('el') || '';
const page = Math.max(1, parseInt(url.searchParams.get('page') || '1', 10));
const pageSize = 16;
const offset = (page - 1) * pageSize;

const whereConditions: string[] = [];
const params: any[] = [];

// Flexible search: matches both Vietnamese accented name and unaccented kebab slug
if (q) {
  const rawTerm = `%${q}%`;
  const slugTerm = `%${q.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/đ/g, 'd').replace(/[^a-z0-9]+/g, '%')}%`;
  whereConditions.push('(name LIKE ? OR slug LIKE ? OR gemstone_type LIKE ? OR short_description LIKE ?)');
  params.push(rawTerm, slugTerm, rawTerm, rawTerm);
}
if (category) {
  whereConditions.push('category_name = ?');
  params.push(category);
}
if (element) {
  whereConditions.push('feng_shui_element = ?');
  params.push(element);
}

const whereSql = whereConditions.length > 0 ? `WHERE ${whereConditions.join(' AND ')}` : '';

const grandTotal = (await db.prepare('SELECT COUNT(*) as count FROM products').first<{ count: number }>())?.count || 380;
const totalCount = (await db.prepare(`SELECT COUNT(*) as count FROM products ${whereSql}`).bind(...params).first<{ count: number }>())?.count || 0;
const totalPages = Math.ceil(totalCount / pageSize) || 1;

const products = (await db.prepare(`
  SELECT id, slug, name, sku, price, price_text, category_name, gemstone_type, feng_shui_element, target_zodiac, thumbnail
  FROM products
  ${whereSql}
  ORDER BY id ASC
  LIMIT ? OFFSET ?
`).bind(...params, pageSize, offset).all<any>()).results || [];

const categories = (await db.prepare('SELECT c.name, COUNT(p.id) as count FROM categories c LEFT JOIN products p ON p.category_name = c.name GROUP BY c.id ORDER BY c.sort_order ASC').all<any>()).results || [];

// Calculate visible page numbers
function getPageList(current: number, total: number) {
  if (total <= 7) return Array.from({ length: total }, (_, i) => i + 1);
  if (current <= 4) return [1, 2, 3, 4, 5, '...', total];
  if (current >= total - 3) return [1, '...', total - 4, total - 3, total - 2, total - 1, total];
  return [1, '...', current - 1, current, current + 1, '...', total];
}
const pageList = getPageList(page, totalPages);

const pageTitle = category 
  ? `${category} Tự Nhiên Cao Cấp` 
  : element 
    ? `Đá Quý Phong Thủy Hợp Mệnh ${element}` 
    : q 
      ? `Tìm Kiếm "${q}" - Sản Phẩm Phong Thủy` 
      : 'Sản Phẩm Đá Quý Phong Thủy Thiên Nhiên';

const pageDesc = category
  ? `Bộ sưu tập ${category} tự nhiên 100% tại Phong Thủy Hoa Mộc Lan TP.HCM. Tuyển chọn tinh tế, hỗ trợ giám định SJC/PNJ theo yêu cầu, giao hàng COD toàn quốc.`
  : element
    ? `Các loại đá quý tự nhiên tương sinh, tương hợp bản mệnh ${element}. Kích hoạt tài lộc, bình an và vượng khí đỉnh cao tại Phong Thủy Hoa Mộc Lan.`
    : 'Danh mục hơn 380 vật phẩm đá quý phong thủy, ngọc tự nhiên, phật bản mệnh 12 con giáp, linh vật chiêu tài kiểm định uy tín tại Showroom Hoa Mộc Lan TP.HCM.';

const canonicalParams = new URLSearchParams();
if (category) canonicalParams.set('cat', category);
if (element) canonicalParams.set('el', element);
if (page > 1) canonicalParams.set('page', page.toString());
const canonicalQuery = canonicalParams.toString();
const canonicalUrl = `https://thegioidaquy.net/san-pham${canonicalQuery ? `?${canonicalQuery}` : ''}`;

const breadcrumbItems: any[] = [
  {
    "@type": "ListItem",
    "position": 1,
    "name": "Trang Chủ",
    "item": "https://thegioidaquy.net"
  },
  {
    "@type": "ListItem",
    "position": 2,
    "name": "Sản Phẩm Phong Thủy",
    "item": "https://thegioidaquy.net/san-pham"
  }
];

if (category) {
  breadcrumbItems.push({
    "@type": "ListItem",
    "position": 3,
    "name": category,
    "item": `https://thegioidaquy.net/san-pham?cat=${encodeURIComponent(category)}`
  });
} else if (element) {
  breadcrumbItems.push({
    "@type": "ListItem",
    "position": 3,
    "name": `Mệnh ${element}`,
    "item": `https://thegioidaquy.net/san-pham?el=${encodeURIComponent(element)}`
  });
}

const catalogSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": `${canonicalUrl}#collection`,
      "url": canonicalUrl,
      "name": pageTitle,
      "description": pageDesc,
      "isPartOf": {
        "@type": "WebSite",
        "@id": "https://thegioidaquy.net/#website"
      }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": breadcrumbItems
    }
  ]
};
---

<StoreLayout 
  title={pageTitle} 
  description={pageDesc} 
  activeNav="products" 
  canonical={canonicalUrl}
  schemaJson={catalogSchema}
>
  <div class="container" style="padding: 40px 24px;">
    <!-- BREADCRUMB -->
    <div style="font-size: 13px; color: var(--text-dim); margin-bottom: 24px;">
      <a href="/" style="color: var(--text-muted); text-decoration: none;">Trang Chủ</a> / 
      <a href="/san-pham" style="color: var(--text-muted); text-decoration: none;">Sản Phẩm Phong Thủy</a>
      {category && <span> / {category}</span>}
      {element && <span> / Mệnh {element}</span>}
    </div>

    <div class="catalog-layout">
      <!-- SIDEBAR FILTERS -->
      <aside class="catalog-sidebar">
        <h3 style="font-size: 16px; font-weight: 700; color: #fff; margin-bottom: 16px; display: flex; justify-content: space-between; align-items: center;">
          <span>Bộ Lọc Sản Phẩm</span>
          {(category || element || q) && (
            <a href="/san-pham" style="font-size: 12px; color: var(--gold-accent); text-decoration: none; font-weight: normal;">
              Xóa tất cả
            </a>
          )}
        </h3>

        <!-- SEARCH -->
        <form method="GET" action="/san-pham" style="margin-bottom: 24px;">
          <input 
            type="text" 
            name="q" 
            value={q} 
            placeholder="Tìm tên đá, linh vật..." 
            class="form-control" 
            style="font-size: 13px; width: 100%;"
          />
          {category && <input type="hidden" name="cat" value={category} />}
          {element && <input type="hidden" name="el" value={element} />}
        </form>

        <!-- ELEMENT FILTER -->
        <div style="margin-bottom: 24px;">
          <h4 style="font-size: 13px; text-transform: uppercase; color: var(--gold-accent); margin-bottom: 10px; font-weight: 700;">
            Theo Ngũ Hành Mệnh
          </h4>
          <div style="display: flex; flex-direction: column; gap: 8px; font-size: 13px;">
            <a href={`/san-pham${category ? `?cat=${encodeURIComponent(category)}` : ''}`} style={`color: ${!element ? 'var(--gold-accent)' : 'var(--text-muted)'}; text-decoration: none; font-weight: ${!element ? '700' : 'normal'};`}>
              Tất cả các mệnh
            </a>
            {['Kim', 'Mộc', 'Thủy', 'Hỏa', 'Thổ', 'Đa Mệnh'].map((el) => (
              <a 
                href={`/san-pham?el=${encodeURIComponent(el)}${category ? `&cat=${encodeURIComponent(category)}` : ''}${q ? `&q=${encodeURIComponent(q)}` : ''}`}
                style={`color: ${element === el ? 'var(--gold-accent)' : 'var(--text-muted)'}; text-decoration: none; font-weight: ${element === el ? '700' : 'normal'}; display: flex; justify-content: space-between; align-items: center;`}
              >
                <span>Mệnh {el}</span>
                {element === el && <span style="font-size: 10px; background: rgba(212,175,55,0.2); padding: 2px 6px; border-radius: 4px;">Đang chọn</span>}
              </a>
            ))}
          </div>
        </div>

        <!-- CATEGORY FILTER -->
        <div>
          <h4 style="font-size: 13px; text-transform: uppercase; color: var(--gold-accent); margin-bottom: 10px; font-weight: 700;">
            Chủng Loại Đá
          </h4>
          <div style="display: flex; flex-direction: column; gap: 8px; font-size: 13px; max-height: 420px; overflow-y: auto; padding-right: 4px;">
            <a href={`/san-pham${element ? `?el=${encodeURIComponent(element)}` : ''}`} style={`color: ${!category ? 'var(--gold-accent)' : 'var(--text-muted)'}; text-decoration: none; font-weight: ${!category ? '700' : 'normal'}; display: flex; justify-content: space-between;`}>
              <span>Tất cả chủng loại</span>
              <span style="color: var(--text-dim);">({grandTotal})</span>
            </a>
            {categories.map((c) => (
              <a 
                href={`/san-pham?cat=${encodeURIComponent(c.name)}${element ? `&el=${encodeURIComponent(element)}` : ''}${q ? `&q=${encodeURIComponent(q)}` : ''}`}
                style={`color: ${category === c.name ? 'var(--gold-accent)' : 'var(--text-muted)'}; text-decoration: none; display: flex; justify-content: space-between; font-weight: ${category === c.name ? '700' : 'normal'};`}
              >
                <span>{c.name}</span>
                <span style="color: var(--text-dim);">({c.count})</span>
              </a>
            ))}
          </div>
        </div>
      </aside>

      <!-- PRODUCTS MAIN LIST -->
      <div>
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; flex-wrap: wrap; gap: 12px;">
          <h1 style="font-family: var(--font-heading); font-size: 24px; color: #fff; margin: 0;">
            {category || (element ? `Đá Quý Hợp Mệnh ${element}` : 'Tất Cả Sản Phẩm Phong Thủy')}
            <span style="font-size: 15px; color: var(--text-dim); font-weight: normal; margin-left: 8px;">({totalCount} vật phẩm)</span>
          </h1>
        </div>

        <!-- ACTIVE FILTER TAGS -->
        {(category || element || q) && (
          <div style="display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 20px;">
            {category && (
              <span style="background: rgba(212,175,55,0.15); border: 1px solid rgba(212,175,55,0.3); border-radius: 20px; padding: 4px 12px; font-size: 12px; color: #fff; display: flex; align-items: center; gap: 6px;">
                Chủng loại: <strong>{category}</strong>
                <a href={`/san-pham?${element ? `el=${encodeURIComponent(element)}` : ''}${q ? `&q=${encodeURIComponent(q)}` : ''}`} style="color: var(--gold-accent); text-decoration: none; font-weight: bold; margin-left: 2px;">✕</a>
              </span>
            )}
            {element && (
              <span style="background: rgba(212,175,55,0.15); border: 1px solid rgba(212,175,55,0.3); border-radius: 20px; padding: 4px 12px; font-size: 12px; color: #fff; display: flex; align-items: center; gap: 6px;">
                Bản mệnh: <strong>Mệnh {element}</strong>
                <a href={`/san-pham?${category ? `cat=${encodeURIComponent(category)}` : ''}${q ? `&q=${encodeURIComponent(q)}` : ''}`} style="color: var(--gold-accent); text-decoration: none; font-weight: bold; margin-left: 2px;">✕</a>
              </span>
            )}
            {q && (
              <span style="background: rgba(212,175,55,0.15); border: 1px solid rgba(212,175,55,0.3); border-radius: 20px; padding: 4px 12px; font-size: 12px; color: #fff; display: flex; align-items: center; gap: 6px;">
                Từ khóa: <strong>"{q}"</strong>
                <a href={`/san-pham?${category ? `cat=${encodeURIComponent(category)}` : ''}${element ? `&el=${encodeURIComponent(element)}` : ''}`} style="color: var(--gold-accent); text-decoration: none; font-weight: bold; margin-left: 2px;">✕</a>
              </span>
            )}
            <a href="/san-pham" style="font-size: 12px; color: var(--text-dim); display: flex; align-items: center; text-decoration: none; padding: 4px 8px;">
              [Xóa bộ lọc]
            </a>
          </div>
        )}

        {products.length === 0 ? (
          <div style="background: var(--store-card); border: 1px solid var(--store-border); border-radius: 14px; padding: 48px 24px; text-align: center;">
            <div style="font-size: 48px; margin-bottom: 16px;">🔮</div>
            <h3 style="font-size: 18px; color: #fff; margin-bottom: 8px;">Không tìm thấy vật phẩm phù hợp</h3>
            <p style="color: var(--text-dim); font-size: 14px; max-width: 480px; margin: 0 auto 24px; line-height: 1.6;">
              {q ? `Không có kết quả nào khớp với từ khóa "${q}". ` : ''}
              Vui lòng thử lại với tên loại đá khác hoặc xóa bộ lọc để xem toàn bộ 380 sản phẩm.
            </p>
            <a href="/san-pham" class="btn-primary" style="display: inline-block; padding: 10px 24px;">
              Xem Toàn Bộ 380 Sản Phẩm
            </a>
          </div>
        ) : (
          <div class="products-grid" style="margin: 0; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));">
            {products.map((p) => {
              const badgeClass = p.feng_shui_element === 'Kim' ? 'badge-kim'
                : p.feng_shui_element === 'Mộc' ? 'badge-moc'
                : p.feng_shui_element === 'Thủy' ? 'badge-thuy'
                : p.feng_shui_element === 'Hỏa' ? 'badge-hoa'
                : p.feng_shui_element === 'Thổ' ? 'badge-tho' : 'badge-damenh';

              return (
                <div class="product-card">
                  <div class="product-card-thumb">
                    <img src={p.thumbnail || '/placeholder-gem.jpg'} alt={p.name} loading="lazy" />
                    <span class={`product-element-tag ${badgeClass}`}>Mệnh {p.feng_shui_element}</span>
                  </div>
                  <div class="product-card-body">
                    <span class="product-cat-label">{p.gemstone_type}</span>
                    <a href={`/san-pham/${p.slug}`} class="product-card-title">{p.name}</a>
                    <div class="product-price-box">
                      <span class="price-current">{p.price_text}</span>
                      <a href={`/san-pham/${p.slug}`} class="btn-detail-link">Xem chi tiết</a>
                    </div>
                  </div>
                </div>
              );
            })}
          </div>
        )}

        <!-- PAGINATION -->
        {totalPages > 1 && (
          <div style="display: flex; justify-content: center; align-items: center; gap: 8px; margin-top: 40px; flex-wrap: wrap;">
            {page > 1 && (
              <a href={`/san-pham?page=${page - 1}&q=${encodeURIComponent(q)}&cat=${encodeURIComponent(category)}&el=${encodeURIComponent(element)}`} class="btn-secondary" style="padding: 8px 14px; font-size: 13px;">
                ← Trước
              </a>
            )}

            {pageList.map((item) => {
              if (item === '...') {
                return <span style="color: var(--text-dim); padding: 0 4px;">...</span>;
              }
              const isCurrent = item === page;
              return (
                <a
                  href={`/san-pham?page=${item}&q=${encodeURIComponent(q)}&cat=${encodeURIComponent(category)}&el=${encodeURIComponent(element)}`}
                  style={`display: inline-flex; align-items: center; justify-content: center; min-width: 36px; height: 36px; border-radius: 8px; font-size: 13px; font-weight: ${isCurrent ? '700' : '500'}; text-decoration: none; border: 1px solid ${isCurrent ? 'var(--gold-accent)' : 'var(--store-border)'}; background: ${isCurrent ? 'var(--gold-accent)' : 'rgba(255,255,255,0.03)'}; color: ${isCurrent ? '#000' : '#fff'};`}
                >
                  {item}
                </a>
              );
            })}

            {page < totalPages && (
              <a href={`/san-pham?page=${page + 1}&q=${encodeURIComponent(q)}&cat=${encodeURIComponent(category)}&el=${encodeURIComponent(element)}`} class="btn-primary" style="padding: 8px 14px; font-size: 13px;">
                Sau →
              </a>
            )}
          </div>
        )}
      </div>
    </div>
  </div>
</StoreLayout>

<style>
  .catalog-layout {
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: 32px;
    align-items: flex-start;
  }
  .catalog-sidebar {
    background: var(--store-card);
    border: 1px solid var(--store-border);
    border-radius: 14px;
    padding: 24px;
    position: sticky;
    top: 90px;
  }
  @media (max-width: 880px) {
    .catalog-layout {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    .catalog-sidebar {
      position: static;
    }
  }
</style>
