---
import '../styles/store.css';
import { getDb } from '../lib/db';

interface Props {
  title: string;
  description?: string;
  activeNav?: string;
  image?: string;
  canonical?: string;
  noindex?: boolean;
  schemaJson?: any;
  ogType?: 'website' | 'article' | 'product';
  publishedTime?: string;
}

const { 
  title, 
  description = 'Cửa hàng đá quý phong thủy thiên nhiên Hoa Mộc Lan TP.HCM - Hơn 15 năm uy tín cung cấp đá quý phong thủy, Phật bản mệnh 12 con giáp, linh vật chiêu tài kiểm định SJC, PNJ.', 
  activeNav = 'home',
  image = '/uploads/site_assets/Phongthuy-HoaMocLan-thegioidaquy.jpg',
  canonical,
  noindex = false,
  schemaJson,
  ogType = 'website',
  publishedTime
} = Astro.props;

const db = getDb(Astro.locals);
const settingsRows = (await db.prepare('SELECT key, value FROM settings').all<{ key: string; value: string }>()).results || [];
const settings: Record<string, string> = {};
for (const r of settingsRows) {
  settings[r.key] = r.value;
}

const hotline = settings.hotline || '0909.468.057';
const address = settings.address || '1163 Đường 3 Tháng 2, P.6, Q.11, TP. HCM';
const siteName = settings.site_name || 'Thế Giới Đá Quý - Phong Thủy Hoa Mộc Lan';

const cleanPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const canonicalUrl = canonical || `https://thegioidaquy.net${cleanPath === '/' ? '' : cleanPath}`;
const ogImage = image.startsWith('http') ? image : `https://thegioidaquy.net${image.startsWith('/') ? '' : '/'}${image}`;

// Schema.org LocalBusiness / JewelryStore (Enriched for Google Local, Maps & AI Overviews)
const defaultOrgSchema = {
  "@context": "https://schema.org",
  "@type": "JewelryStore",
  "@id": "https://thegioidaquy.net/#organization",
  "name": siteName,
  "legalName": "Hộ Kinh Doanh Đoàn Quốc Sơn - Cửa Hàng Phong Thủy Hoa Mộc Lan",
  "alternateName": ["Phong Thủy Hoa Mộc Lan", "The Gioi Da Quy", "Hoa Moc Lan Gemstone"],
  "url": "https://thegioidaquy.net",
  "logo": "https://thegioidaquy.net/favicon.png",
  "image": ogImage,
  "description": description,
  "telephone": hotline.replace(/\./g, ''),
  "taxID": "41K8013290",
  "foundingDate": "2010",
  "priceRange": "$$",
  "currenciesAccepted": "VND",
  "paymentAccepted": "Tiền mặt, Chuyển khoản ngân hàng, Thẻ tín dụng, Thu hộ COD toàn quốc",
  "email": settings.email || "thegioidaquy.net@gmail.com",
  "founder": {
    "@type": "Person",
    "name": "Đoàn Quốc Sơn",
    "jobTitle": "Chuyên gia Cố vấn Phong Thủy"
  },
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "1163 Đường 3 Tháng 2, Phường 6",
    "addressLocality": "Quận 11",
    "addressRegion": "Hồ Chí Minh",
    "postalCode": "700000",
    "addressCountry": "VN"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 10.7592,
    "longitude": 106.6575
  },
  "hasMap": "https://maps.google.com/?q=1163+Duong+3+Thang+2+Phuong+6+Quan+11+TPHCM",
  "areaServed": [
    { "@type": "City", "name": "Thành phố Hồ Chí Minh" },
    { "@type": "AdministrativeArea", "name": "Quận 11" },
    { "@type": "AdministrativeArea", "name": "Quận 5" },
    { "@type": "AdministrativeArea", "name": "Quận 10" },
    { "@type": "AdministrativeArea", "name": "Tân Bình" },
    { "@type": "Country", "name": "Việt Nam" }
  ],
  "contactPoint": {
    "@type": "ContactPoint",
    "telephone": "+84909468057",
    "contactType": "customer service",
    "areaServed": "VN",
    "availableLanguage": ["vi"]
  },
  "knowsAbout": [
    "Đá quý phong thủy tự nhiên",
    "Vòng tay đá phong thủy theo ngũ hành",
    "Phật bản mệnh 12 con giáp",
    "Linh vật chiêu tài Tỳ Hưu, Thiềm Thừ",
    "Giám định đá quý tự nhiên SJC, PNJ"
  ],
  "openingHoursSpecification": {
    "@type": "OpeningHoursSpecification",
    "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"],
    "opens": "09:00",
    "closes": "21:30"
  },
  "sameAs": [
    "https://zalo.me/0909468057",
    ...(settings.facebook ? [settings.facebook] : [])
  ]
};
---

<!doctype html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | {siteName}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Geographic & Regional SEO (Local Pack & Mapping) -->
    <meta name="geo.region" content="VN-SG" />
    <meta name="geo.placename" content="Quận 11, Thành phố Hồ Chí Minh" />
    <meta name="geo.position" content="10.7592;106.6575" />
    <meta name="ICBM" content="10.7592, 106.6575" />

    <!-- Robots Meta Tags: Explicitly allow Google and all search engines -->
    {noindex ? (
      <meta name="robots" content="noindex, nofollow" />
      <meta name="googlebot" content="noindex, nofollow" />
    ) : (
      <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
      <meta name="googlebot" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    )}

    <!-- Open Graph / Facebook SEO -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={`${title} | ${siteName}`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={title} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="vi_VN" />
    {ogType === 'article' && publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )}

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} | ${siteName}`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={title} />

    <!-- Google Search Console Verification -->
    <meta name="google-site-verification" content="qAplo78rRsnNpAAXF8cRMVlIOhrfswjsjqtmg7JvST8" />

    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Schema.org Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(defaultOrgSchema)} />
    {schemaJson && (
      <script type="application/ld+json" set:html={JSON.stringify(schemaJson)} />
    )}
  </head>
  <body class="store-body">
    <!-- Announcement Bar -->
    <div class="announcement-bar">
      <span>💎 100% Đá Quý Thiên Nhiên - Có Giám Định SJC, PNJ Theo Yêu Cầu</span>
      <span>📍 Showroom: {address}</span>
      <span>📞 Hotline / Zalo: <a href={`tel:${hotline}`}>{hotline}</a></span>
    </div>

    <!-- Store Header -->
    <header class="store-header">
      <div class="header-inner">
        <a href="/" class="store-logo">
          <div class="logo-badge">
            <img src="/favicon.png" alt="Thế Giới Đá Quý - Phong Thủy Hoa Mộc Lan" width="32" height="32" style="width: 32px; height: 32px; object-fit: contain;" />
          </div>
          <div class="logo-titles">
            <span class="logo-main-title">Thế Giới Đá Quý</span>
            <span class="logo-sub-title">PHONG THỦY HOA MỘC LAN</span>
          </div>
        </a>

        <nav class="store-nav">
          <a href="/" class={activeNav === 'home' ? 'active' : ''}>Trang Chủ</a>
          <a href="/san-pham" class={activeNav === 'products' ? 'active' : ''}>Sản Phẩm Phong Thủy</a>
          <a href="/tin-tuc" class={activeNav === 'news' || activeNav === 'blog' ? 'active' : ''}>Tin Tức & Cẩm Nang</a>
          <a href="/giao-nhan" class={activeNav === 'shipping' ? 'active' : ''}>Giao Nhận</a>
          <a href="/cau-hoi-thuong-gap" class={activeNav === 'faqs' ? 'active' : ''}>Hỏi Đáp</a>
          <a href="/gioi-thieu" class={activeNav === 'about' ? 'active' : ''}>Giới Thiệu</a>
          <a href="/lien-he" class={activeNav === 'contact' ? 'active' : ''}>Liên Hệ</a>
        </nav>

        <div class="header-actions">
          <!-- Quick Search in Header -->
          <form action="/san-pham" method="GET" class="header-search-form" role="search">
            <input 
              type="search" 
              name="q" 
              placeholder="Tìm đá quý, linh vật..." 
              autocomplete="off"
              aria-label="Tìm kiếm sản phẩm phong thủy"
            />
            <button type="submit" aria-label="Tìm kiếm">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width: 15px; height: 15px;">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
              </svg>
            </button>
          </form>

          <a href={`tel:${hotline}`} class="btn-hotline">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width: 16px; height: 16px;">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
            </svg>
            <span>{hotline}</span>
          </a>

          <button id="mobile-menu-btn" class="btn-mobile-menu" aria-label="Mở menu điều hướng" onclick="toggleMobileMenu()">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width: 20px; height: 20px;">
              <path d="M4 6h16M4 12h16M4 18h16"></path>
            </svg>
          </button>
        </div>
      </div>
    </header>

    <!-- Mobile Horizontal Sub-Navigation (Swipeable Pills) -->
    <nav class="mobile-subnav" aria-label="Điều hướng nhanh di động">
      <a href="/" class={activeNav === 'home' ? 'active' : ''}>Trang Chủ</a>
      <a href="/san-pham" class={activeNav === 'products' ? 'active' : ''}>Sản Phẩm</a>
      <a href="/tin-tuc" class={activeNav === 'news' || activeNav === 'blog' ? 'active' : ''}>Tin Tức</a>
      <a href="/giao-nhan" class={activeNav === 'shipping' ? 'active' : ''}>Giao Nhận</a>
      <a href="/cau-hoi-thuong-gap" class={activeNav === 'faqs' ? 'active' : ''}>Hỏi Đáp</a>
      <a href="/gioi-thieu" class={activeNav === 'about' ? 'active' : ''}>Giới Thiệu</a>
      <a href="/lien-he" class={activeNav === 'contact' ? 'active' : ''}>Liên Hệ</a>
    </nav>

    <!-- Mobile Drawer Overlay Menu -->
    <div id="mobile-drawer" class="mobile-drawer">
      <div class="mobile-drawer-header">
        <span style="font-weight: 700; color: #fff; font-size: 16px;">Menu Điều Hướng</span>
        <button type="button" onclick="toggleMobileMenu()" class="btn-close-drawer" aria-label="Đóng menu">✕</button>
      </div>
      <div style="padding: 16px 20px 8px;">
        <form action="/san-pham" method="GET">
          <input 
            type="search" 
            name="q" 
            placeholder="🔍 Tìm đá quý, linh vật..." 
            class="form-control"
            style="width: 100%; font-size: 14px; background: rgba(255,255,255,0.08); border-color: rgba(212,175,55,0.3); color: #fff; border-radius: 20px; padding: 10px 16px;"
          />
        </form>
      </div>
      <div class="mobile-drawer-links">
        <a href="/" class={activeNav === 'home' ? 'active' : ''}>🏠 Trang Chủ</a>
        <a href="/san-pham" class={activeNav === 'products' ? 'active' : ''}>💎 Sản Phẩm Phong Thủy</a>
        <a href="/tin-tuc" class={activeNav === 'news' || activeNav === 'blog' ? 'active' : ''}>📰 Tin Tức & Cẩm Nang Đá Quý</a>
        <a href="/giao-nhan" class={activeNav === 'shipping' ? 'active' : ''}>🚚 Chính Sách Giao Nhận</a>
        <a href="/cau-hoi-thuong-gap" class={activeNav === 'faqs' ? 'active' : ''}>❓ Câu Hỏi Thường Gặp (FAQs)</a>
        <a href="/gioi-thieu" class={activeNav === 'about' ? 'active' : ''}>✨ Giới Thiệu Cửa Hàng</a>
        <a href="/lien-he" class={activeNav === 'contact' ? 'active' : ''}>📍 Bản Đồ & Thông Tin Liên Hệ</a>
        <a href="/chinh-sach-va-quy-dinh">📜 Chính Sách & Quy Định Chung</a>
        <a href="/chinh-sach-bao-mat">🔒 Chính Sách Bảo Mật</a>
        <a href="/hinh-thuc-thanh-toan">💳 Hình Thức Thanh Toán</a>
        <a href="/cam-ket-kiem-dinh">🛡️ Cam Kết Giám Định SJC</a>
      </div>
      <div class="mobile-drawer-footer">
        <p style="color: var(--text-dim); font-size: 13px; margin-bottom: 8px;">Hotline tư vấn 24/7:</p>
        <a href={`tel:${hotline}`} class="btn-primary" style="display: flex; justify-content: center; gap: 8px; font-weight: 700; width: 100%;">
          📞 {hotline}
        </a>
      </div>
    </div>
    <div id="mobile-backdrop" class="mobile-backdrop" onclick="toggleMobileMenu()"></div>

    <!-- Content Slot -->
    <main>
      <slot />
    </main>

    <!-- Floating Consultation Widget -->
    <div class="floating-widget">
      <a href={`https://zalo.me/${hotline.replace(/[^0-9]/g, '')}`} target="_blank" rel="noopener noreferrer" class="btn-floating-zalo" title="Tư vấn nhanh qua Zalo">
        <span>Zalo</span>
      </a>
    </div>

    <!-- Store Footer -->
    <footer class="store-footer">
      <div class="container">
        <div class="footer-grid">
          <div class="footer-col">
            <h4>{siteName}</h4>
            <p style="margin-bottom: 10px;">Chuyên trang cung cấp đá quý phong thủy, phật bản mệnh 12 con giáp, ngọc thiên nhiên kiểm định chất lượng cao uy tín tại Việt Nam.</p>
            <p><strong>Showroom:</strong> {address} (gần ngã 4 Tạ Uyên đối diện bánh Đức Phát cũ)</p>
            <p><strong>Hotline / Zalo:</strong> <a href={`tel:${hotline}`} style="color: var(--gold-accent); text-decoration: none;">{hotline}</a> (Mr. Sơn)</p>
            <p><strong>Điện thoại bàn:</strong> (028) 3501 9991</p>
            <p><strong>Chủ hộ kinh doanh:</strong> {settings.owner || 'Đoàn Quốc Sơn'}</p>
            <p><strong>ĐKKD số:</strong> 41K8013290 cấp ngày 06/08/2012 do UBND Quận 11, TP.HCM cấp</p>
            <p><strong>Giờ mở cửa:</strong> {settings.business_hours || '09:00 - 21:30 hàng ngày'}</p>
          </div>

          <div class="footer-col">
            <h4>Danh Mục Đá Quý</h4>
            <ul>
              <li><a href="/san-pham?cat=Đá+Thạch+Anh">Đá Thạch Anh Năng Lượng</a></li>
              <li><a href="/san-pham?cat=Đá+Mắt+Hổ">Đá Mắt Hổ Dũng Khí</a></li>
              <li><a href="/san-pham?cat=Đá+Ngọc+Bích">Đá Ngọc Bích Bình An</a></li>
              <li><a href="/san-pham?cat=Đá+Ruby">Đá Ruby Đỏ Quyền Lực</a></li>
              <li><a href="/san-pham?cat=Đá+Hắc+Ngà+(Obsidian)">Đá Hắc Ngà Trừ Tà</a></li>
              <li><a href="/san-pham?cat=Vòng+Tay+Phong+Thủy">Vòng Tay Phong Thủy</a></li>
            </ul>
          </div>

          <div class="footer-col">
            <h4>Tin Tức & Cẩm Nang</h4>
            <ul>
              <li><a href="/tin-tuc/tac-dung-cua-3-loai-da-phong-thuy-pho-bien-hien-nay">Tác Dụng 3 Loại Đá Phong Thủy</a></li>
              <li><a href="/tin-tuc/cach-dat-tuong-di-lac-hop-phong-thuy">Cách Đặt Tượng Phật Di Lặc</a></li>
              <li><a href="/tin-tuc/ho-phach-la-gi-lich-su-khai-thac-va-su-dung-ho-phach">Hổ Phách Là Gì & Tác Dụng</a></li>
              <li><a href="/tin-tuc/deo-nhan-ngon-giua-de-giu-tien-va-chieu-tai">Đeo Nhẫn Ngón Giữa Giữ Tiền</a></li>
              <li><a href="/tin-tuc/kinh-nghiem-nhan-biet-mua-ban-cam-thach-that">Nhận Biết Cẩm Thạch Thật</a></li>
              <li><a href="/tin-tuc" style="color: var(--gold-accent); font-weight: 700;">Xem tất cả bài viết tin tức →</a></li>
            </ul>
          </div>

          <div class="footer-col">
            <h4>Chính Sách & Cam Kết</h4>
            <ul>
              <li><a href="/gioi-thieu">Giới Thiệu Showroom</a></li>
              <li><a href="/chinh-sach-va-quy-dinh">Chính Sách Quy Định Chung</a></li>
              <li><a href="/chinh-sach-bao-mat">Chính Sách Bảo Mật</a></li>
              <li><a href="/hinh-thuc-thanh-toan">Hình Thức Thanh Toán</a></li>
              <li><a href="/giao-nhan">Chính Sách Giao Nhận COD</a></li>
              <li><a href="/cau-hoi-thuong-gap">Câu Hỏi Thường Gặp (FAQs)</a></li>
              <li><a href="/cam-ket-kiem-dinh">Cam Kết Giám Định SJC</a></li>
            </ul>
          </div>
        </div>

        <div class="footer-bottom" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px;">
          <p>© 2010 - 2026 Thế Giới Đá Quý - Cửa Hàng Phong Thủy Hoa Mộc Lan. Showroom: 1163 Đường 3 Tháng 2, Q.11, TP.HCM.</p>
          <div style="font-size: 12px; color: var(--text-dim);">
            <a href="/admin" rel="nofollow" style="color: var(--text-dim); text-decoration: none; opacity: 0.6; transition: opacity 0.2s;" onmouseover="this.style.opacity='1'" onmouseout="this.style.opacity='0.6'">Quản trị hệ thống</a>
          </div>
        </div>
      </div>
    </footer>

    <script is:inline>
      function toggleMobileMenu() {
        const drawer = document.getElementById('mobile-drawer');
        const backdrop = document.getElementById('mobile-backdrop');
        if (drawer && backdrop) {
          const isOpen = drawer.classList.contains('open');
          if (isOpen) {
            drawer.classList.remove('open');
            backdrop.classList.remove('open');
            document.body.style.overflow = '';
          } else {
            drawer.classList.add('open');
            backdrop.classList.add('open');
            document.body.style.overflow = 'hidden';
          }
        }
      }
    </script>
  </body>
</html>
